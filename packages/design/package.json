{
  "name": "@entoli/design",
  "version": "0.1.0",
  "description": "Extract an app's design system (colours, fonts, radius, shadow) from its code and its running pages, and generate the Entoli theme from it.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "typescript": "^5.6.3" },
  "devDependencies": { "@types/node": "^22.10.0", "vitest": "^2.1.8" }
}
