{
  "name": "@entoli/tester",
  "version": "0.1.0",
  "description": "Walk an app's Entoli map in a real browser and report coverage and broken paths.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "entoli-test": "./bin/entoli-test.mjs" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "@entoli/sdk": "workspace:*" },
  "peerDependencies": { "playwright": ">=1.40" },
  "peerDependenciesMeta": { "playwright": { "optional": true } },
  "devDependencies": { "@types/node": "^22.10.0", "typescript": "^5.6.3", "vitest": "^2.1.8" }
}
