# Entoli web app (apps/web). Copy to apps/web/.env.local for local dev, or set in Vercel.
# Nothing here is required for local dev: without them the dashboard runs on an
# in-process Postgres (PGlite) with a local "dev" user and no billing.

# --- Database (Neon / Vercel Postgres). Required in production.
DATABASE_URL=

# --- Auth.js with GitHub OAuth (github.com/settings/developers → OAuth App)
#     Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- GitHub App (read-only repo access; write only for guided-integration PRs)
#     Setup URL: https://<your-domain>/api/github/setup   (check "Redirect on update")
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY= # PEM; newlines may be written as \n

# --- Optional: the marketing site's own Ask bar can use the model fallback
NEXT_PUBLIC_ENTOLI_SITE_KEY=
NEXT_PUBLIC_ENTOLI_ENDPOINT=
