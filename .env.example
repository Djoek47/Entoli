# Entoli web app (apps/web). Copy to apps/web/.env.local for local dev, or set in Vercel.
# Nothing here is required for local dev: without them the dashboard runs on an
# in-process Postgres (PGlite) with a local "dev" user and no billing.

# --- Database (Neon / Vercel Postgres). Required in production.
DATABASE_URL=

# --- Auth.js with GitHub OAuth (github.com/settings/developers → OAuth App)
#     Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- GitHub App (read-only repo access; write only for guided-integration PRs)
#     Setup URL: https://<your-domain>/api/github/setup   (check "Redirect on update")
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY= # PEM; newlines may be written as \n

# --- Anthropic (Claude): analysis review pass (M4) and the runtime fallback (M5).
#     Without it, analysis is static-only and /api/intent answers "no match".
ANTHROPIC_API_KEY=
ENTOLI_MODEL=                 # default claude-opus-5-5
ANALYSIS_MAX_INPUT_TOKENS=    # default 60000
ANALYSIS_MAX_OUTPUT_TOKENS=   # default 32000

INTENT_RATE_PER_MIN=          # per app key, default 120
VOICE_TOOL_TURNS=             # voice-tool turns per L2 app per month, default 300

# --- Stripe (M6). Run `node apps/web/scripts/stripe-setup.mjs` once per mode (test, live).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=        # from the webhook endpoint https://<domain>/api/stripe/webhook
CRON_SECRET=                  # Vercel sends it to /api/cron/usage; any long random string
APP_URL=                      # https://<your-domain>, used for Checkout return URLs

# --- Tester (M8): a hosted Chromium for dashboard-run walks in production (Playwright connect URL)
BROWSER_WS_ENDPOINT=
ENTOLI_CHROMIUM_PATH=         # optional: a specific local Chromium build

# --- Optional: the marketing site's own Ask bar can use the model fallback
NEXT_PUBLIC_ENTOLI_SITE_KEY=
NEXT_PUBLIC_ENTOLI_ENDPOINT=
