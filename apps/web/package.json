{
  "name": "@entoli/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-site.mjs && next dev",
    "build": "node scripts/build-site.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@entoli/analyzer": "workspace:*",
    "@entoli/design": "workspace:*",
    "@entoli/sdk": "workspace:*",
    "@entoli/tester": "workspace:*",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/sandbox": "^4.0.0",
    "diff": "^8.0.4",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "next": "^16.4.5",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^23.1.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
